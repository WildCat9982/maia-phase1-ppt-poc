# Copy to .env and fill in.

# --- Model -------------------------------------------------------------
# openai = any OpenAI-compatible endpoint; mock = canned answers, no model needed
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Leave empty for api.openai.com. For the on-prem Qwen server later, e.g.:
# LLM_BASE_URL=https://qwen.internal:8443/v1
# LLM_MODEL=qwen3.6-35b-a3b
LLM_BASE_URL=
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=4
# Set false if a server rejects response_format=json_object
LLM_JSON_MODE=true

# --- Behaviour ---------------------------------------------------------
MASK_PII=true
MAX_UPLOAD_MB=20
# Optional default template used when none is uploaded (.potx or .pptx)
TEMPLATE_PATH=

# --- UI ----------------------------------------------------------------
MAIA_BACKEND_URL=http://localhost:8000
